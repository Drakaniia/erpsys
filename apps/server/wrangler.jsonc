{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erpsys-api",
  "account_id": "fab94f3e8a58d3b3509d01f11a67b843",
  "main": "worker.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  "minify": true,
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "CLOUDFLARE_WORKER": "1",
    "NODE_ENV": "production",
    "SERVE_WEB": "false",
    "PUBLIC_SITE_URL": "https://erpsys.pages.dev",
    "BETTER_AUTH_URL": "https://erpsys.pages.dev",
    "WEB_ORIGIN": "https://erpsys.pages.dev"
  }
}
